#include <stdio.h>
#include <unistd.h>
#include <fcntl.h>

int main() {
    int fd[2];
    pipe(fd);

    pid_t pid = fork();

    if (pid == 0) {
        close(fd[1]);
        dup2(fd[0], STDOUT_FILENO);
        execlp("cat", "cat", "input.txt", NULL);
    } else {
        close(fd[0]);
        int out = open("errors.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
        dup2(out, STDOUT_FILENO);
        dup2(fd[1], STDIN_FILENO);
        execlp("grep", "grep", "ERROR", NULL);
    }
    return 0;
}




// corrected   answer of  this  code !


#include <stdio.h>
#include <stdlib.h>   // exit() ke liye
#include <unistd.h>   // pipe(), fork(), dup2(), close(), execlp() ke liye
#include <fcntl.h>    // open(), O_WRONLY, O_CREAT, O_TRUNC ke liye
#include <sys/wait.h> // wait() ke liye

int main() {
    int fd[2];

    // 1. Pipe banayein aur error check karein
    if (pipe(fd) == -1) {
        perror("pipe failed");
        return 1;
    }

    // 2. Process create karein aur error check karein
    pid_t pid = fork();
    if (pid < 0) {
        perror("fork failed");
        return 1;
    }

    if (pid == 0) {
        // ================= CHILD PROCESS (cat input.txt) =================
        close(fd[0]);                      // Unused READ end band karein
        dup2(fd[1], STDOUT_FILENO);        // Screen output (STDOUT) ko pipe ke WRITE end se jorein
        close(fd[1]);                      // Duplicate original write fd band karein

        execlp("cat", "cat", "input.txt", NULL);
        perror("execlp cat failed");       // Agar execlp fail ho tabhi yeh line chalegi
        exit(1);
    } 
    else {
        // ================= PARENT PROCESS (grep ERROR > errors.txt) =================
        close(fd[1]);                      // Unused WRITE end band karein

        // Output file kholein aur error check karein
        int out = open("errors.txt", O_WRONLY | O_CREAT | O_TRUNC, 0644);
        if (out < 0) {
            perror("open errors.txt failed");
            return 1;
        }

        dup2(out, STDOUT_FILENO);          // Output (STDOUT) ko errors.txt file se jorein
        close(out);                        // Duplicate original file fd band karein

        dup2(fd[0], STDIN_FILENO);         // Input (STDIN) ko pipe ke READ end se jorein
        close(fd[0]);                      // Duplicate original read fd band karein

        execlp("grep", "grep", "ERROR", NULL);
        perror("execlp grep failed");      // Agar execlp fail ho tabhi yeh line chalegi
        return 1;
    }

    return 0;
}
